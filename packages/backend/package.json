{
  "name": "@sonic-atlas/backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node check-node-version.js && node --env-file=../../.env --conditions development --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/src/index.js",
    "check": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "music-metadata": "^12.2.2",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#db/*": {
      "development": "./db/*.ts",
      "default": "./db/*.js"
    }
  }
}
